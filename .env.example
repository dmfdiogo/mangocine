# TMDB API Configuration
# Get your free API key at https://www.themoviedb.org/settings/api
#
# Provide EITHER the v3 API key OR the v4 read access token.
# The app works without this file using a public read-only demo key,
# but you should supply your own credentials in real deployments.
TMDB_API_KEY=your_v3_api_key_here
TMDB_API_READ_ACCESS_TOKEN=your_v4_read_access_token_here
